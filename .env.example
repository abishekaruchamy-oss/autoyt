# ==============================================================
# AutoShorts Platform Environment Configuration
# ==============================================================

# Database Connection (PostgreSQL)
# For local Docker: postgresql://autoshorts:autoshorts_secure_password_2026@localhost:5432/autoshorts_db
DATABASE_URL=postgresql://autoshorts:autoshorts_secure_password_2026@localhost:5432/autoshorts_db

# Security: 256-bit (32-byte) Hex Key for AES-256-GCM Token Encryption at Rest
TOKEN_ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90

# Meta Developer / Instagram Graph API OAuth
META_CLIENT_ID=your_meta_app_id
META_CLIENT_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# Google Drive API (Google One Storage)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# YouTube Data API v3
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# n8n Webhook Secret & Endpoint
N8N_WEBHOOK_URL=http://localhost:5678/webhook/instagram-to-youtube-trigger
N8N_WEBHOOK_SECRET=autoshorts_webhook_secret_key_2026

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
