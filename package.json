{
  "name": "n8n",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/guard-production-build.js && next build",
    "build:worker": "node scripts/guard-production-build.js && opennextjs-cloudflare build",
    "preview:worker": "wrangler dev",
    "deploy:dry-run": "node scripts/guard-production-build.js && wrangler deploy --dry-run",
    "deploy": "node scripts/guard-production-build.js && opennextjs-cloudflare build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:migrate": "wrangler d1 migrations apply autoshorts-db --remote",
    "d1:migrate:local": "wrangler d1 migrations apply autoshorts-db --local",
    "d1:init:local": "wrangler d1 execute autoshorts-db --local --file=db/d1-schema.sql",
    "d1:migrations:status": "wrangler d1 execute autoshorts-db --remote --command \"SELECT id, name, applied_at FROM d1_migrations ORDER BY id;\"",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx tests/test-suite.ts",
    "test:d1": "tsx tests/d1-repository.test.ts",
    "test:audit": "tsx tests/production-readiness-audit.ts",
    "test:phase3": "tsx tests/phase3-submission-engine.ts",
    "test:media": "tsx tests/phase3-1-media-retrieval.ts",
    "test:live": "tsx tests/phase3-1-live-pipeline.ts",
    "test:experiment": "tsx tests/first-live-experiment-zackdfilms.ts",
    "test:reel-retrieval": "tsx tests/test-reel-dff42ifnipz.ts",
    "test:reclip": "tsx tests/phase3-4-reclip-ytdlp.ts",
    "test:phase3-5": "tsx tests/phase3-5-real-drive-and-background.ts",
    "test:encryption": "tsx tests/encryption-security.test.ts",
    "test:dedup": "tsx tests/atomic-deduplication.test.ts",
    "test:recovery": "tsx tests/safe-retry-and-recovery.test.ts",
    "test:build-guard": "tsx tests/production-build-guard.test.ts",
    "test:security": "tsx tests/phase9-1-security-hardening.test.ts",
    "test:ui-integrity": "tsx tests/phase9-6-ui-and-data-integrity.test.ts",
    "test:all": "tsx tests/test-suite.ts && tsx tests/production-readiness-audit.ts && tsx tests/phase3-submission-engine.ts && tsx tests/d1-repository.test.ts && tsx tests/encryption-security.test.ts && tsx tests/atomic-deduplication.test.ts && tsx tests/safe-retry-and-recovery.test.ts && tsx tests/production-build-guard.test.ts && tsx tests/phase9-1-security-hardening.test.ts && tsx tests/phase9-6-ui-and-data-integrity.test.ts",
    "clean": "node scripts/clean.js"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.159.0"
  }
}
