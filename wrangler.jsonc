{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autoshorts",
  "account_id": "c06a57f039a7cb0e9e20016f3d1a3234",
  "main": "worker/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "vars": {
    "STORAGE_DEFAULT_FOLDER": "Instagram Reels Backup",
    "POLLING_INTERVAL_MINUTES": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autoshorts-db",
      "database_id": "9a677418-27cc-46dd-bb6a-e988f8170975"
    }
  ]
}
